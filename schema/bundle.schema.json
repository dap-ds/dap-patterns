{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dap-ds.github.io/dap-patterns/schema/bundle.schema.json",
  "title": "DAP pattern bundle (one file per pattern)",
  "description": "patterns/<id>.json: the pattern tree plus its registry metadata. This is exactly what the Figma plugin's Export produces, so a contributor can paste it as a new file. registry.json is generated from these files by CI.",
  "type": "object",
  "required": [
    "pattern",
    "item"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "pattern": {
      "$ref": "pattern.schema.json"
    },
    "item": {
      "$ref": "#/definitions/item"
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category",
        "status",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human title shown in the plugin list (HU)."
        },
        "description": {
          "type": "string",
          "description": "One or two sentences: what it is and when to use it."
        },
        "category": {
          "$ref": "#/definitions/id",
          "description": "e.g. forms, navigation, feedback, content, layout, page."
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Search keywords (HU + EN)."
        },
        "status": {
          "enum": [
            "draft",
            "stable",
            "deprecated"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "semver of the pattern tree. Breaking = atoms/props replaced, non-breaking = spacing/copy."
        },
        "replacedBy": {
          "$ref": "#/definitions/id",
          "description": "Only for status=deprecated."
        },
        "updatedAt": {
          "type": "string",
          "format": "date"
        },
        "pattern": {
          "description": "generated by the build; ignored"
        },
        "preview": {
          "type": "object",
          "required": [
            "src"
          ],
          "additionalProperties": false,
          "properties": {
            "src": {
              "type": "string",
              "description": "PNG/WebP preview for the plugin card."
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "uses": {
          "description": "generated by the build; ignored"
        },
        "code": {
          "type": "object",
          "description": "Code counterpart of the same pattern (shadcn-style registry item), if one exists.",
          "additionalProperties": false,
          "properties": {
            "registryItem": {
              "type": "string",
              "description": "Path/URL of the code registry item, e.g. dap-screen-kit registry id or a source file."
            },
            "framework": {
              "enum": [
                "stencil",
                "react",
                "html"
              ]
            },
            "screenKit": {
              "type": "string",
              "description": "dap-screen-kit registry key, if this pattern maps to a ScreenRenderer block."
            }
          }
        },
        "figma": {
          "type": "object",
          "description": "Optional Figma-native source (library component) for the library-key insert mode. Not needed for tree-based insert.",
          "additionalProperties": false,
          "properties": {
            "fileKey": {
              "type": "string"
            },
            "componentKey": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "nodeId": {
              "type": "string"
            }
          }
        },
        "modes": {
          "type": "object",
          "description": "Variable modes the preview/tree was authored in (informational; the tree's own `modes` is what the plugin applies).",
          "additionalProperties": {
            "type": "string"
          }
        },
        "treeHash": {
          "description": "generated by the build; ignored"
        }
      },
      "description": "Registry metadata of one pattern. `pattern`, `uses` and `treeHash` are GENERATED by the build and ignored if present (the Figma plugin export includes them).",
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "deprecated"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "replacedBy"
            ]
          }
        }
      ]
    }
  }
}
