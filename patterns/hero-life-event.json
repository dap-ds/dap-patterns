{
  "$schema": "../schema/bundle.schema.json",
  "pattern": {
    "schema": 1,
    "id": "hero-life-event",
    "modes": {
      "color-theme": "Indigo",
      "typography-theme": "desktop"
    },
    "root": {
      "type": "FRAME",
      "name": "Hero (life event)",
      "layout": {
        "direction": "VERTICAL",
        "gap": "{spacing.600}",
        "padding": "{spacing.1200}",
        "counterAlign": "CENTER"
      },
      "width": "{breakpoints.large}",
      "height": "HUG",
      "fill": "{background.brand.base-inverted}",
      "children": [
        {
          "type": "FRAME",
          "name": "Content",
          "layout": {
            "direction": "VERTICAL",
            "gap": "{spacing.600}"
          },
          "width": "FILL",
          "height": "HUG",
          "maxWidth": "{containers.xlarge}",
          "children": [
            {
              "type": "FRAME",
              "name": "Share and print",
              "layout": {
                "direction": "HORIZONTAL",
                "gap": "{spacing.300}"
              },
              "width": "FILL",
              "height": "HUG",
              "children": [
                {
                  "type": "INSTANCE",
                  "name": "Share",
                  "component": "Button (subtle)",
                  "variant": {
                    "Size": "xSmall",
                    "State": "Enabled",
                    "Color": "Inverted"
                  },
                  "properties": {
                    "Label": "Megosztás",
                    "Icon Leading": false,
                    "Icon Trailing": false
                  }
                },
                {
                  "type": "INSTANCE",
                  "name": "Print",
                  "component": "Button (subtle)",
                  "variant": {
                    "Size": "xSmall",
                    "State": "Enabled",
                    "Color": "Inverted"
                  },
                  "properties": {
                    "Label": "Nyomtatás",
                    "Icon Leading": false,
                    "Icon Trailing": false
                  }
                }
              ]
            },
            {
              "type": "FRAME",
              "name": "Text",
              "layout": {
                "direction": "VERTICAL",
                "gap": "{spacing.200}"
              },
              "width": "FILL",
              "height": "HUG",
              "children": [
                {
                  "type": "TEXT",
                  "name": "Page title",
                  "chars": "Page title",
                  "textStyle": "{Heading.Heading 1}",
                  "color": "{text.neutral.on-inverted}",
                  "width": "FILL"
                },
                {
                  "type": "TEXT",
                  "name": "Description",
                  "chars": "Short description. Can be a couple sentences long.",
                  "textStyle": "{Body.Large.Regular}",
                  "color": "{text.neutral.on-inverted}",
                  "width": "FILL"
                }
              ]
            },
            {
              "type": "FRAME",
              "name": "Actions",
              "layout": {
                "direction": "HORIZONTAL",
                "gap": "{spacing.300}",
                "wrap": true
              },
              "width": "FILL",
              "height": "HUG",
              "children": [
                {
                  "type": "INSTANCE",
                  "name": "Link",
                  "component": "Button (outline)",
                  "variant": {
                    "Size": "Small",
                    "State": "Enabled",
                    "Color": "Inverted"
                  },
                  "properties": {
                    "Label": "Link 01",
                    "Icon Leading": false,
                    "Icon Trailing": false
                  },
                  "repeat": [
                    {
                      "properties": {
                        "Label": "Link 01"
                      }
                    },
                    {
                      "properties": {
                        "Label": "Link 02"
                      }
                    },
                    {
                      "properties": {
                        "Label": "Link 03"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "item": {
    "id": "hero-life-event",
    "title": "Hero – életesemény",
    "description": "Inverted (márkaszínű) oldalfejléc életesemény oldalakhoz: megosztás/nyomtatás, cím, rövid leírás és legfeljebb három gyorslink. Az illusztráció és a megosztás/nyomtatás ikonok még nem DS kulcsok, ezek külön kerülnek rá.",
    "category": "page",
    "tags": [
      "hero",
      "életesemény",
      "life event",
      "oldalfejléc",
      "header",
      "inverted"
    ],
    "status": "draft",
    "version": "0.1.0",
    "updatedAt": "2026-10-14"
  }
}
